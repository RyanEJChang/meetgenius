# Flask
SECRET_KEY=change-this-to-a-random-string

# 本地 Postgres 連線設定
MEETGENIUS_DB_HOST=localhost
MEETGENIUS_DB_PORT=5432
MEETGENIUS_DB_NAME=meetgenius
MEETGENIUS_DB_USER=meetgenius
MEETGENIUS_DB_PASSWORD=

# OpenAI（會議摘要 / action items / FAQ / 補充文件摘要 / 翻譯狀態查詢 / 翻譯）
# 留空 AZURE_OPENAI_ENDPOINT 走原生 OpenAI API，OPENAI_MODEL 是模型名稱。
# 填入 endpoint 則走 Azure OpenAI，OPENAI_API_KEY 放 Azure 資源金鑰，
# 且 OPENAI_MODEL / OPENAI_TRANSLATION_MODEL 改為 deployment 名稱。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Azure Speech-to-Text（語音轉錄 + 語者分離）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_API_VERSION=2024-11-15
